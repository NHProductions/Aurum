function fizzbuzz(int amt) -> void {
    for (int n = 1; n <= amt; n++) {
        if ( (n % 3 == 0) && (n % 5 != 0) ) {
            print("fizz\n");
        }
        elif ( (n % 5 == 0) && (n % 3 != 0) ) {
            print("buzz\n");
        }
        elif ( (n % 5 == 0) && (n % 3 == 0) ) {
            print("fizzbuzz\n");
        }
        else {
            print("%i\n", n);
        }
    }
}