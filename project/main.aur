import @time;
function main() -> void {
    string m = "Hello World!" + "a";
    print("%s", m);


    print("Hello World!" + 'a');
    print("easdf");
    string n = "Previous Chars: ";
    for (int i = 0; i < 5; i++) {
        n = n + popcon(true, true);
        sleep(1000);
    }
    print("\n\n%s", n);
}